# Copy to .env and fill in. .env is gitignored; this file is the committed
# template — see docs/ARCHITECTURE.md §5 ("Two connection strings") and §10
# ("Secrets").

# --- Local Postgres (packages/db/docker-compose.yml) ---------------------
# Password for the local dev container. Any value works locally; this is
# never the value used against a real Supabase project.
POSTGRES_PASSWORD=changeme

# --- Two connection strings ------------------------------------------------
#
# Locally these point at the SAME local Docker Postgres (there's no pooler
# running on a laptop) — but in every deployed environment they are
# DIFFERENT Supabase connection strings, and mixing them up fails silently
# until the wrong code path hits it:
#
#   DATABASE_URL — the Supabase transaction-mode POOLER, port 6543.
#     Used by runtime code (packages/db `dbPooled()`): Next.js
#     loaders/actions/route handlers, and any future Vercel Cron endpoint.
#     The pooler does not support prepared statements, which is why
#     `dbPooled()` sets `prepare: false` — this must never be dropped, or
#     every query works locally and fails once deployed to Vercel.
#
#   DIRECT_URL — the Supabase DIRECT connection, port 5432.
#     Used by migrations and one-off scripts (packages/db `dbDirect()`,
#     `drizzle-kit migrate`, `pnpm db:seed`). Transaction-mode pooling does
#     not support the multi-statement transactions a migration runs as.
#     Run migrations from a local machine or CI — never from the Vercel
#     build, which only ever has DATABASE_URL (the pooler) available.
#
# Local (both point at packages/db/docker-compose.yml, port 5433):
DATABASE_URL=postgres://summerice:changeme@localhost:5433/summerice
DIRECT_URL=postgres://summerice:changeme@localhost:5433/summerice

# Supabase, for reference once the project exists (do not commit real
# values — these are illustrative shapes only):
#   DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   DIRECT_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase project (browser + server) -----------------------------------
# NEXT_PUBLIC_* is exposed to the browser bundle by Next.js — fine here,
# since the anon key is designed to be public and Realtime fill counts are
# not secret (see docs/ARCHITECTURE.md on the live-fill broadcast). Never
# put the service_role key behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only, once Supabase Auth is wired (a later session — see
# docs/ARCHITECTURE.md §7). Never exposed to the browser.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
