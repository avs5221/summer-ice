# Copy to .env and fill in. .env is gitignored; this file is the committed
# template — see docs/ARCHITECTURE.md §10 ("Secrets").

# Password for the summerice Postgres role, used by infra/compose.dev.yml
# and embedded in DATABASE_URL below. Any value works locally; pick
# something real before this ever points at a shared or production box.
POSTGRES_PASSWORD=changeme

# Dev connects over TCP to the Compose container on the host-mapped port
# (5433, not Postgres's default 5432 — see infra/compose.dev.yml). Production
# connects over a unix socket instead, since web/worker/postgres run on the
# same box there — the connection string is expected to differ by
# environment; that's not a bug, don't try to unify them.
DATABASE_URL=postgres://summerice:changeme@localhost:5433/summerice
