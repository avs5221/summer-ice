{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@summerice/core": ["./packages/core/index.ts"],
      "@summerice/contracts": ["./packages/contracts/index.ts"],
      "@summerice/db": ["./packages/db/index.ts"],
      "~/*": ["./apps/web/app/*"]
    }
  },
  "include": [
    "apps/web/app/**/*.ts",
    "apps/web/app/**/*.tsx",
    "apps/web/*.ts",
    "packages/*/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/build", "**/.next"]
}
