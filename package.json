{
  "name": "summer-ice",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "pnpm --filter @summerice/web run typegen",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "pnpm --if-present -r run typecheck",
    "lint": "eslint .",
    "lint:all": "pnpm --if-present -r run lint",
    "dev:web": "pnpm --filter @summerice/web run dev",
    "db:generate": "pnpm --filter @summerice/db run generate",
    "db:migrate": "pnpm --filter @summerice/db run migrate",
    "db:studio": "pnpm --filter @summerice/db run studio",
    "db:seed": "pnpm --filter @summerice/db run seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.0",
    "globals": "17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
