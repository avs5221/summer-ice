{
  "name": "summer-ice",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @summerice/web run typegen",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "pnpm --if-present -r run typecheck",
    "lint": "eslint .",
    "lint:all": "pnpm --if-present -r run lint",
    "dev:web": "pnpm --filter @summerice/web run dev",
    "start:worker": "pnpm --filter @summerice/worker run start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1"
  }
}
