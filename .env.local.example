# Local development ONLY. Copy to .env.local. Read by every ordinary db:*
# script by default — see CLAUDE.md → "Environment files" for the full
# local/production split and why it exists.
#
# This only ever talks to your own machine's Docker container
# (packages/db/docker-compose.yml, port 5433) — it is never the Supabase
# password or connection string. Keep it that way: a distinct local-only
# value here is what makes the localhost guard (packages/db/guard-host.ts)
# meaningful rather than coincidental.
POSTGRES_PASSWORD=changeme_local_only

DATABASE_URL=postgres://summerice:changeme_local_only@localhost:5433/summerice
DIRECT_URL=postgres://summerice:changeme_local_only@localhost:5433/summerice
